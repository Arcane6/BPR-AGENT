# Configuração do Agente BPR e do orquestrador.
#
# Copie para .env (na mesma pasta deste arquivo) e preencha. O .env não
# vai para o git. Caminho do Windows vai sem aspas e com barra invertida
# normal: BPR_DADOS_DIR=C:\Users\<usuario>\OneDrive\BPR\Agente

# ------------------------------------------------------------------
# Pastas e bases
# ------------------------------------------------------------------

# Pasta-raiz das bases. Com ela, os caminhos abaixo são opcionais: o
# padrão de cada um fica dentro desta pasta.
#   <BPR_DADOS_DIR>\Base de dados do Agente BPR.xlsx
#   <BPR_DADOS_DIR>\Resultado do Agente BPR.xlsx
#   <BPR_DADOS_DIR>\Bases auxiliares\Base TSSR RCU Disponíveis.csv
#   <BPR_DADOS_DIR>\Bases auxiliares\Base de enlaces ociosos.csv
#   <BPR_DADOS_DIR>\TSSR\Input
#   <BPR_DADOS_DIR>\Bases do extrator\(SEM ID.xlsx, Sites.csv, Endereços.csv, R041_Trat.csv, MOBILESITE.csv)
BPR_DADOS_DIR=

# Cada caminho pode apontar para outro lugar (deixe vazio para usar o padrão).
BPR_BASE_PATH=
BPR_RESULT_PATH=
BPR_TSSR_RCU_DISPONIVEIS_PATH=
BPR_BASE_ENLACES_TX_PATH=
BPR_TSSR_INPUT_DIR=

# Bases do extrator de TSSR (só usadas com a extração autorizada, Ação 5.2B).
BPR_TSSR_BASE_SEM_ID_PATH=
BPR_TSSR_BASE_SITES_PATH=
BPR_TSSR_BASE_ENDERECOS_PATH=
BPR_TSSR_BASE_R041_PATH=
BPR_TSSR_BASE_NGNIS_PATH=

# ------------------------------------------------------------------
# BigQuery
# ------------------------------------------------------------------

# Obrigatórios: sem eles, as consultas ao BigQuery devolvem erro de
# configuração, em vez de consultar o projeto padrão das credenciais.
BPR_BIGQUERY_PROJECT_ID=
BPR_BIGQUERY_DATASET=

# Tabela a tabela, quando não seguem <projeto>.<dataset>.<nome padrão>.
BPR_BIGQUERY_TSSR_TABLE=
BPR_BIGQUERY_TSSR_INFOSITES_TABLE=
BPR_BIGQUERY_TSSR_EQUIPAMENTOS_TABLE=

# ------------------------------------------------------------------
# Modelo e limites
# ------------------------------------------------------------------

BPR_MODEL_NAME=gemini-2.5-flash
BPR_TSSR_EXTRACTOR_TIMEOUT_SECONDS=600

# Orquestrador (ver orquestrador_bpr/config.py).
ORQ_MODEL_NAME=gemini-2.5-flash
ORQ_SAIDA_DIR=saida_orquestrador
ORQ_TIMEOUT_POR_ENDERECO_S=1800
ORQ_MAX_TENTATIVAS_ANALISE=2
ORQ_MAX_TENTATIVAS_GRAVACAO=3
ORQ_ESPERA_GRAVACAO_S=20
ORQ_MAX_ENDERECOS_POR_CHAMADA=20
# Porta da tela local (python -m servidor_bpr), sempre em 127.0.0.1.
ORQ_SERVIDOR_PORTA=8765

# ------------------------------------------------------------------
# Google: Gemini pelo Vertex AI e BigQuery, com as credenciais da
# aplicação (a mesma identidade para os dois, como no portal).
# Chave de API não é aceita: GOOGLE_API_KEY e GEMINI_API_KEY são
# descartadas ao carregar (agente_bpr/credenciais.py), e o Vertex AI é
# ligado em código, sem precisar de GOOGLE_GENAI_USE_VERTEXAI.
# ------------------------------------------------------------------
# JSON da service account. Vazio = credencial padrão da máquina
# (`gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=
# Projeto do Vertex AI. Vazio = o projeto da credencial.
GOOGLE_CLOUD_PROJECT=
# Região do Vertex AI (ex.: us-central1). Vazio = global.
GOOGLE_CLOUD_LOCATION=
